# Application
NODE_ENV=development
HOST=127.0.0.1
PORT=3000

# Local PostgreSQL
POSTGRES_DB=cop
POSTGRES_USER=cop
POSTGRES_PASSWORD=cop
DATABASE_URL=postgresql://cop:cop@localhost:5432/cop

# Local URLs
WEB_URL=http://localhost:5173
API_URL=http://localhost:3000

# Optional: protected local folder for Better Auth secret and one-time setup token.
# COP_DATA_DIR=C:\Users\YOUR_USER\.cop
# No real SMTP credentials: development uses fixed localhost:1025 capture only.
